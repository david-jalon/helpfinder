# ──────────────────────────────────────────────
# Helpfinder — variables de entorno (referencia)
# Copia este archivo a .env.local y rellena tus valores.
# .env.local NO se sube al repositorio (ver .gitignore).
# ──────────────────────────────────────────────

# Públicas (el navegador las usa): proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Solo servidor: SERVICE ROLE key. La usan el cron y «Seguir» para escribir
# la caché pública `grants_seen` (que tiene RLS cerrada). NUNCA al navegador.
# Supabase → Project Settings → API → service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# Solo servidor: secreto que protege el cron diario.
# En Vercel debe coincidir con Settings → Cron Jobs → secret.
CRON_SECRET=cambia-este-valor

# Solo servidor: API BDNS (Ministerio de Hacienda). Requeridas: sin ellas el
# buscador y el detalle de convocatoria fallan.
BDNS_SEARCH_ENDPOINT=https://www.pap.hacienda.gob.es/bdnstrans/api/convocatorias/busqueda
BDNS_BASE_URL=https://www.pap.hacienda.gob.es/bdnstrans/api

# Opcionales (el código tiene valores por defecto).
# Modelo Gemini principal (default: gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash
# Modelos de respaldo (coma) si el principal da 503/404. OJO: solo Gemini 3.x
# vigentes; los 2.0 están apagados y los 2.5 tienen acceso restringido.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# Reintentos con backoff ante 429/5xx, y espera base en ms.
# AI_RETRY_ATTEMPTS=2
# AI_RETRY_BASE_MS=400
# AI_MAX_GRANTS_PER_CALL=10
# AI_MAX_NEW_GRANTS_PER_RUN=200
# CRON_SEARCH_DAYS=7
# CRON_MAX_PAGES=10
# CRON_ENRICH_RETRY_LIMIT=50
# BDNS_TIMEOUT_MS=12000
# BDNS_RETRIES=2
# BDNS_SEARCH_CACHE_TTL_SECONDS=300
# BDNS_DETAIL_CACHE_TTL_SECONDS=3600
# BDNS_ENRICH_MAX_PER_REQUEST=30
